# Generated by scripts/start-relay.sh from config/snapserver.conf.template - edit the template.
[server]
datadir = __STATE_DIR__/snapserver
mdns_enabled = false

[http]
enabled = true
port = 1780
doc_root = __SNAPWEB_DIR__

[tcp-control]
enabled = false

[tcp-streaming]
enabled = true
port = 1704

[stream]
source = process://__CAPTURE_SCRIPT__?name=HomeStream&sampleformat=48000:16:2&log_stderr=true
# Opus keeps the bitrate low enough for cellular; flac is ~1 Mbit/s.
codec = opus
# Clients play this far behind live. Raise it if audio drops out on a weak connection.
buffer = 1500

[logging]
filter = *:info
