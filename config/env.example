# HomeStream settings. setup.sh copies this to ../.env and fills in the token.

# Devices on your Tailscale network get in without a password (1), or need the token too (0).
HOMESTREAM_TRUST_TAILSCALE=1

# Password for everything that isn't on Tailscale (e.g. a device on the Mac's Wi-Fi).
# Long and random; setup.sh generates one.
HOMESTREAM_TOKEN=

# What to control: auto | nowplaying | spotify | browser | dryrun
#   auto       - macOS Now Playing via media-control when installed (any app, track info,
#                no permissions); otherwise the Spotify app or the system media keys
#   nowplaying - macOS Now Playing only (needs: brew install media-control)
#   spotify    - Spotify desktop app via AppleScript
#   browser    - system media keys (needs the Accessibility permission; play and pause both toggle)
#   dryrun     - a pretend player that only logs commands (for development)
HOMESTREAM_PLAYER=auto

# CoreAudio input to capture. "test-tone" streams a 440 Hz beep instead (no BlackHole needed).
HOMESTREAM_AUDIO_DEVICE="BlackHole 2ch"
HOMESTREAM_BITRATE=192k

# Where the control server listens. 0.0.0.0 = all interfaces (the token still guards every route).
# Set it to your Tailscale IP to refuse connections from the local network entirely.
HOMESTREAM_HOST=0.0.0.0
HOMESTREAM_PORT=8765

# Switch the Mac's sound output to BlackHole while the relay runs, and switch it back on exit.
# Needs switchaudio-osx (setup.sh installs it). 0 = leave output alone, e.g. if you use a Multi-Output Device.
HOMESTREAM_AUTO_ROUTE=1

# Also run a Snapcast server (for the Snapdroid Android app / multi-room). 0 = HTTP stream only.
HOMESTREAM_SNAPCAST=0
