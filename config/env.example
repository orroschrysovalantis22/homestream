# HomeStream settings. Created by setup (or `homestream config`) with a fresh token.

# Devices on your Tailscale network get in without a password (1), or need the token too (0).
HOMESTREAM_TRUST_TAILSCALE=1

# Password for everything that isn't on Tailscale (e.g. a device on this computer's Wi-Fi).
# Long and random; setup generates one.
HOMESTREAM_TOKEN=

# What to capture. Empty = this computer's default: "BlackHole 2ch" on macOS, whatever the
# speakers play on Windows and Linux. "test-tone" and "test-signal" stream test sounds instead.
# `homestream doctor` lists what can be captured.
HOMESTREAM_AUDIO_DEVICE=
HOMESTREAM_BITRATE=192k

# What to control: auto (the best for this OS) or dryrun (a pretend player, for development).
#   macOS   also: nowplaying (any app, via media-control), spotify (the Spotify app), browser (media keys)
#   Linux   also: mpris (any MPRIS player, via playerctl). HOMESTREAM_MPRIS_PLAYER=spotify pins one player.
#   Windows also: windows (the system media controls)
HOMESTREAM_PLAYER=auto

# Where the server listens. 0.0.0.0 = all network interfaces (access rules still apply).
HOMESTREAM_HOST=0.0.0.0
HOMESTREAM_PORT=8765

# macOS only: switch the sound output to BlackHole while HomeStream runs, and back afterwards.
# 0 = leave the output alone, e.g. if you use a Multi-Output Device to hear it on the Mac too.
HOMESTREAM_AUTO_ROUTE=1

# Also run a Snapcast server (for the Snapdroid Android app / multi-room). 0 = HTTP stream only.
HOMESTREAM_SNAPCAST=0
